  <script>
    const fondos = {
      rojo:   'linear-gradient(135deg,#a81010,#5c0b0b)',
      noche:  'linear-gradient(135deg,#0f1023,#1e2148)',
      nobel:  'linear-gradient(135deg,#8a6d00,#3b2f00)',
      oceano: 'linear-gradient(135deg,#0b3d5c,#052a3d)',
      argel:  'linear-gradient(135deg,#c96a1a,#7a3b09)'
    };

    function cambiarFondo(nombre){
      document.body.style.background = fondos[nombre] || fondos.rojo;
    }

    function alternarAnimacion(activo){
      document.body.classList.toggle('bg-anim', activo);
    }

    function revisarQuiz(){
      const form = document.getElementById('quiz-form');
      const total = 4;
      let correctas = 0;
      for (let i = 1; i <= total; i++){
        const seleccion = form.querySelector('input[name="p' + i + '"]:checked');
        if (seleccion && seleccion.value === 'correcta') correctas++;
      }
      const resultado = document.getElementById('quiz-result');
      resultado.textContent = 'Puntaje: ' + correctas + ' de ' + total + ' correctas.';
    }
  </script>
